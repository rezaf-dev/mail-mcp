# Set the deployed host once. OAuth issuer and MCP endpoint derive from this value.
MCP_BASE_URL=https://mailmcp.on-forge.com

# Generate once with: php -r "echo base64_encode(random_bytes(32)), PHP_EOL;"
# Keep stable: this key encrypts SMTP passwords saved through the admin panel.
APP_KEY=replace-with-base64-encoded-32-byte-key

# Request and attachment limits.
MAX_ATTACHMENT_BYTES=10485760
MAX_TOTAL_ATTACHMENT_BYTES=20971520
MAX_ATTACHMENTS=5

# Bound SMTP connection and command waits so tool calls return a failure promptly.
SMTP_TIMEOUT_SECONDS=15
